-- SQL Filtering, Grouping & Aggregation
-- ==========================================================

-- ==========================================================
-- TASK 1: WHERE FILTERING
-- WHERE filters rows BEFORE grouping.
-- Used for removing invalid or unnecessary records.
-- ==========================================================

SELECT
    customer_id,
    SUM(amount) AS annual_revenue,
    COUNT(*) AS transaction_count
FROM transactions
WHERE transaction_date >= DATE '2024-01-01'     -- Current year transactions
  AND amount > 0                                -- Remove refunds/negative values
  AND transaction_status = 'completed'          -- Only completed transactions
GROUP BY customer_id
ORDER BY annual_revenue DESC;


-- ==========================================================
-- TASK 2: GROUP BY + AGGREGATION
-- GROUP BY multiple dimensions with aggregate functions.
-- WHERE executes BEFORE GROUP BY.
-- ==========================================================

SELECT
    c.customer_type,
    DATE_TRUNC('month', t.transaction_date)::DATE AS month,
    COUNT(DISTINCT t.customer_id) AS unique_customers,
    COUNT(*) AS transaction_count,
    SUM(t.amount) AS monthly_revenue,
    AVG(t.amount) AS average_transaction
FROM transactions t
JOIN customers c
    ON t.customer_id = c.customer_id
WHERE t.transaction_date >= DATE '2024-01-01'
GROUP BY
    c.customer_type,
    DATE_TRUNC('month', t.transaction_date)
ORDER BY month DESC, monthly_revenue DESC;


-- ==========================================================
-- TASK 3: HAVING FILTERING
-- HAVING filters groups AFTER aggregation.
-- ==========================================================

SELECT
    customer_id,
    COUNT(*) AS transaction_count,
    SUM(amount) AS annual_revenue
FROM transactions
WHERE transaction_date >= DATE '2024-01-01'
GROUP BY customer_id
HAVING SUM(amount) > 10000
   AND COUNT(*) >= 5
ORDER BY annual_revenue DESC;


-- ==========================================================
-- TASK 4: WHERE + HAVING COMBINED
-- WHERE filters rows.
-- HAVING filters grouped results.
-- ==========================================================

SELECT
    c.customer_type,
    COUNT(DISTINCT t.customer_id) AS segment_customers,
    SUM(t.amount) AS segment_revenue,
    ROUND(AVG(t.amount),2) AS average_order_value
FROM transactions t
JOIN customers c
    ON t.customer_id = c.customer_id
WHERE t.transaction_date >= DATE '2024-01-01'
  AND t.transaction_status = 'completed'
  AND t.amount > 0
GROUP BY c.customer_type
HAVING COUNT(DISTINCT t.customer_id) >= 100
   AND SUM(t.amount) > 100000
ORDER BY segment_revenue DESC;


-- ==========================================================
-- TASK 5: ORDER BY + RANK
-- Rank customer segments by revenue.
-- ==========================================================

SELECT
    c.customer_type,
    c.industry,
    COUNT(DISTINCT t.customer_id) AS customers,
    SUM(t.amount) AS total_revenue,
    ROUND(AVG(t.amount),2) AS average_order,
    RANK() OVER (
        ORDER BY SUM(t.amount) DESC
    ) AS revenue_rank
FROM transactions t
JOIN customers c
    ON t.customer_id = c.customer_id
WHERE t.transaction_date >= DATE '2024-01-01'
GROUP BY
    c.customer_type,
    c.industry
HAVING COUNT(DISTINCT t.customer_id) >= 10
ORDER BY total_revenue DESC
LIMIT 20;


-- ==========================================================
-- BONUS QUERY
-- Percentage share of total revenue by customer type.
-- ==========================================================

SELECT
    c.customer_type,
    SUM(t.amount) AS total_revenue,
    ROUND(
        SUM(t.amount) * 100.0 /
        SUM(SUM(t.amount)) OVER (),
        2
    ) AS revenue_percentage
FROM transactions t
JOIN customers c
    ON t.customer_id = c.customer_id
WHERE t.transaction_date >= DATE '2024-01-01'
GROUP BY c.customer_type
ORDER BY total_revenue DESC;